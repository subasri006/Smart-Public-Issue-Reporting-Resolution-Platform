# ==============================================================================
# CivicFix — Environment Configuration Template
# Copy this file to .env in backend or set environment variables before running
# ==============================================================================

# Backend Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Required when SPRING_PROFILES_ACTIVE=mysql)
DB_URL=jdbc:mysql://localhost:3306/civicfix_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here

# Security & JWT Token Authentication
# Secret key must be at least 256 bits (32+ alphanumeric characters) for HMAC-SHA256
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_here
JWT_EXPIRATION_MS=86400000

# Single Initial System Administrator Account
# Configure secure production credentials before initializing the database
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_USERNAME=admin
ADMIN_NAME=Chief Administrator

# File Storage Configuration
FILE_UPLOAD_DIR=./uploads/complaints
FILE_MAX_SIZE=5242880

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration (frontend/.env)
VITE_API_URL=http://localhost:8080/api
