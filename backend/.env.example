# ==============================================================================
# CivicFix Backend (MERN Stack) - Environment Configuration
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Atlas URI for production, local URI for development)
# Local: mongodb://127.0.0.1:27017/civicfix
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/civicfix?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/civicfix

# JWT Stateless Authentication Configuration
# Provide a cryptographically secure 256-bit string in production
JWT_SECRET=CivicFixSuperSecretKeyForJwtTokenGeneration2026SecureStringWith256Bits
JWT_EXPIRES_IN=24h

# Allowed Frontend Client Origin (used by CORS middleware)
CLIENT_URL=http://localhost:5173

# Local File Storage Destination
UPLOAD_DIR=./uploads/complaints

# Primary Initial Administrator Account Bootstrapping
# Bootstrapped automatically if no administrator exists in the database
CIVICFIX_ADMIN_EMAIL=admin@civicfix.org
CIVICFIX_ADMIN_USERNAME=admin
CIVICFIX_ADMIN_PASSWORD=change_this_to_a_secure_admin_password
CIVICFIX_ADMIN_NAME=Chief Administrator

# CivicFix Domain Algorithms Configuration
DUPLICATE_WINDOW_DAYS=30
DUPLICATE_THRESHOLD_PERCENTAGE=45.0
PRIORITY_AGE_WEIGHT_PER_DAY=2.0
PRIORITY_MAX_AGE_WEIGHT=30.0
