# CivicFix .gitignore

# Java / Maven build output
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar

# Frontend / Node.js
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and Secrets
.env
.env.local
.env.*
!.env.example
*.pem
*.key

# Local File Uploads
uploads/complaints/*
!uploads/complaints/.gitkeep
backend/uploads/**
!backend/uploads/
!backend/uploads/complaints/
!backend/uploads/complaints/.gitkeep

# Temporary build scripts and arguments
backend/cp.txt
backend/sources_*.txt
*.tmp
*.bak

# IDEs and Editors
.idea/
*.iml
.vscode/
*.code-workspace
.settings/
.project
.classpath
.factorypath

# OS Specific
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
logs/

# Additional build output
backend/build/
frontend/build/
coverage/

# Environment secrets
!.env.example

# Uploaded files - keep only placeholder
uploads/*
!uploads/.gitkeep
